# 把本文件复制为 .env，再填入你自己的真实信息。
# 注意：.env 里是密码和密钥，千万不要发给别人，也不要上传到网上。

# DeepSeek 开放平台申请的 API Key
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-请在这里填写你的DeepSeek密钥

# 可选。官方文档当前常用模型名是 deepseek-chat 或 deepseek-flash
DEEPSEEK_MODEL=deepseek-chat

# 你的 QQ 邮箱完整地址，例如 123456789@qq.com
QQ_EMAIL=你的QQ号@qq.com

# QQ 邮箱的 16 位授权码（不是 QQ 登录密码）
# 获取方法见脚本注释，或看我发给你的运行说明
QQ_AUTH_CODE=请在这里填写16位授权码

# 收件人。多个邮箱用英文逗号分隔，不要空格也行，有空格也可以
# 例如：111@qq.com,222@qq.com,333@qq.com
TO_EMAIL=你的QQ号@qq.com,另一个QQ号@qq.com
